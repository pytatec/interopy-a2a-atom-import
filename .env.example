# Configuração do atom_import.py (roda NA MÁQUINA DO ATOM, via cron).
# Copie para `.env` ao lado do script e ajuste os valores.

# Raiz da instalação do AtoM (onde existe o arquivo `symfony` e roda `php symfony`).
ATOM_ROOT=/usr/share/nginx/atom

# Diretório de entrada — DEVE ser o mesmo apontado por ATOM_RSYNC_PATH no backend Interopy.
INCOMING_DIR=/var/atom-import/incoming

# Diretórios auxiliares.
WORK_DIR=/var/atom-import/work
ERROR_DIR=/var/atom-import/error
# Fila de espera pelo DIP do Archivematica (reprocessada a cada execução).
RETRY_DIR=/var/atom-import/retry
LOG_FILE=/var/log/atom-import.log
LOCK_FILE=/var/atom-import/.lock

# Binário do PHP.
PHP_BIN=php

# Modo de atualização do csv:import. match-and-update + --skip-unmatched: SÓ atualiza
# descrições já existentes (nunca cria — quem cria é o DIP do Archivematica).
UPDATE_MODE=match-and-update

# --- Localização da descrição no AtoM de CARGA quando o slug muda ---
# O Archivematica cria a descrição no AtoM de carga com um slug próprio (`<uuid>-arquivo`),
# diferente do slug de origem (captura). Quando o csv:export pelo slug do CSV falha, o
# script busca a descrição na API REST do AtoM de carga por reference_code/identifier.
# ATOM_API_BASE_URL vazio DESLIGA essa busca (fica só o csv:export pelo slug do CSV).
ATOM_API_BASE_URL=https://atom-arpdf.pyta.com.br
ATOM_API_KEY=
# Campos da busca boolean do AtoM tentados em ordem (separados por vírgula). Casa-se pelo
# reference_code (código completo, único → campo referenceCode); identifier é secundário e
# usa a FOLHA do código (ex.: 40). (ATOM_MATCH_FIELD singular ainda é aceito — mas NÃO use
# identifier sozinho, senão não casa o código completo.)
ATOM_MATCH_FIELDS=referenceCode,identifier
# Verificar o certificado TLS da API (false para certificado self-signed).
ATOM_API_VERIFY_TLS=true

# Após o lote, rodar `php symfony cc` + `search:populate --update` (true/false).
RUN_INDEX=true

# Só processa arquivos sem modificação há pelo menos N segundos (evita pegar rsync em andamento).
STABLE_SECONDS=60

# Timeout (segundos) por execução de `php symfony`.
COMMAND_TIMEOUT=1800

# Tempo máximo (segundos) que um ISAD espera o DIP do Archivematica antes de desistir
# (→ ERROR_DIR). Padrão 6h. Enquanto dentro do prazo, fica em RETRY_DIR e é retentado.
RETRY_MAX_AGE_SECONDS=21600

# --- Imagem do contêiner (docker-compose.yml; não é lida pelo atom_import.py) ---
# Tag vX.Y.Z publicada no GHCR (ghcr.io/pytatec/interopy-a2a-atom-import). Obrigatória.
ATOM_IMPORT_VERSION=v1.0.0
# Opcionais: outro registro/nome de imagem e a política de pull.
# ATOM_IMPORT_IMAGE=ghcr.io/pytatec/interopy-a2a-atom-import
# ATOM_IMPORT_PULL_POLICY=missing
